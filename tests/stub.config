/*
 * Test-only overrides for `-stub-run`.
 *
 * Nextflow still launches process containers in stub mode (it only swaps the
 * script body), so disable Docker entirely here. Stub tests run on any host
 * with just Java + Nextflow — no Docker, no vendor tools, no secrets.
 */
docker.enabled = false
process.container = null

/*
 * Cap resource requests so the local executor doesn't demand more than a
 * CI runner has. check_max() (nextflow.config) clamps every label to these,
 * so e.g. COMET's process_high_constant (128 cpus) drops to max_cpus. Keep
 * max_cpus <= 4 — GitHub-hosted runners have few cores and little RAM.
 */
params.max_cpus = 2
params.max_memory = '6.GB'
