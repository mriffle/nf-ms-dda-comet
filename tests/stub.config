/*
 * Test-only overrides for `-stub-run`.
 *
 * Nextflow still launches process containers in stub mode (it only swaps the
 * script body), so disable Docker entirely here. Stub tests run on any host
 * with just Java + Nextflow — no Docker, no vendor tools, no secrets.
 */
docker.enabled = false
process.container = null

// Force local execution even under -profile aws (whose real executor is
// awsbatch). Stub tests exercise wiring, not the executor; this keeps the
// AWS-path cases runnable without a real AWS Batch backend.
process.executor = 'local'

/*
 * Cap resource requests so the local executor doesn't demand more than a
 * CI runner has. process.resourceLimits (conf/base.config) clamps every label
 * to these, so e.g. COMET's process_high_constant (128 cpus) drops to the cpus
 * limit. Keep cpus <= 4 — GitHub-hosted runners have few cores and little RAM.
 * Assign the whole map directly (not params): this `-c` file is merged after
 * the profile's resourceLimits, and a direct assignment overrides it cleanly.
 */
process.resourceLimits = [ cpus: 2, memory: '6.GB', time: '240.h' ]
