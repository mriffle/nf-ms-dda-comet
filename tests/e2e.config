/*
 * Config for the real-tool E2E smoke suite (tests/run-e2e-tests.sh).
 *
 * Unlike tests/stub.config, this runs the ACTUAL tools in their containers, so
 * Docker stays enabled (it is on by default in nextflow.config — restated here
 * so a profile that disabled it can't quietly turn this into a no-op).
 */
docker.enabled = true

// Run on the launch host, one task at a time. The suite uses tiny inputs, so
// serializing keeps peak resource use low without meaningfully slowing it.
process.executor   = 'local'
executor.queueSize = 1

/*
 * Cap resource requests to what a small CI runner (or a laptop) actually has.
 * process.resourceLimits (conf/base.config) clamps every label to these, so
 * COMET's process_high_constant (128 cpus / 60 GB) and PERCOLATOR's
 * process_high_memory (40 GB) drop to the limits below — otherwise the local
 * executor refuses to schedule them. Keep cpus <= 4 (GitHub runners are small);
 * 6 GB is ample for the tiny test-data inputs (filter_pin's JVM gets -Xmx5G).
 * Assign the whole map directly (not params): this `-c` file merges after the
 * profile's resourceLimits, and a direct assignment overrides it cleanly.
 */
process.resourceLimits = [ cpus: 2, memory: '6.GB', time: '240.h' ]
