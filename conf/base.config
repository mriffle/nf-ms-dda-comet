
process {
    // Cap every process's resources at these maxima. This is the native
    // Nextflow (>=24.04) replacement for the old check_max() helper: each
    // cpus/memory/time request below is automatically clamped to these limits,
    // so the closures can state the raw desired amount. Each execution profile
    // (standard/slurm/aws in nextflow.config) overrides this with values that
    // match the target machine; this is just the default. NOTE: assign it as a
    // literal map, never via params — a `-c`-supplied params override (e.g. a
    // user's copied pipeline.config, or tests/stub.config) is merged after this
    // file is parsed, so a param reference here would freeze before the
    // override lands. Direct `process.resourceLimits` assignments merge
    // last-wins and override cleanly.
    resourceLimits = [ cpus: 8, memory: '12.GB', time: '240.h' ]

    cpus   = { 1    * task.attempt }
    memory = { 4.GB * task.attempt }
    time   = { 1.h  * task.attempt }

    errorStrategy = { task.exitStatus in [143,137,104,134,139,5,6,null] ? 'retry' : 'finish' }
    maxRetries    = 3
    maxErrors     = '-1'

    // Process-specific resource requirements
    // NOTE - Please try and re-use the labels below as much as possible.
    //        These labels are used and recognised by default in DSL2 files hosted on nf-core/modules.
    //        If possible, it would be nice to keep the same label naming convention when
    //        adding in your local modules too.
    // See https://www.nextflow.io/docs/latest/config.html#config-process-selectors
    withLabel:process_low_constant {
        cpus   = { 2 }
        memory = { 8.GB }
        time   = { 1.h }
    }
    withLabel:process_low {
        cpus   = { 2     * task.attempt }
        memory = { 8.GB  * task.attempt }
        time   = { 2.h   * task.attempt }
    }
    withLabel:process_medium {
        cpus   = { 4     * task.attempt }
        memory = { 15.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    withLabel:process_high {
        cpus   = { 32    * task.attempt }
        memory = { 60.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    withLabel:process_long {
        time   = { 240.h * task.attempt }
    }
    withLabel:process_high_memory {
        memory = { 40.GB * task.attempt }
    }
    withLabel:error_ignore {
        errorStrategy = 'ignore'
    }
    withLabel:error_retry {
        errorStrategy = 'retry'
        maxRetries    = 2
    }

    withLabel:process_high_constant {
        cpus   = { 128 }
        memory = { 60.GB }
        time   = { 8.h }
    }
}
