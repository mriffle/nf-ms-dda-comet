/**
 * # Parameters for nf-maccoss-trex
 *
 * A NextFlow pipeline for analyzing data-ind
 */
params {
    /** \group{Input/Output Parameters} */

    /** \type{string} \required
     *  Path to the FASTA file containing the subset of proteins sequences to
     *  search.
     */
    fasta = null

    /** \type{string} \required
     *  The directory containing the mzML or raw files to search
     */
    spectra_dir = null

    /** \type{string} \required
     *  Location of the comet params file
     */
    comet_params = 'comet.params'

    /** \type{boolean} \required
     *  Whether to post-process all comet results separately. If true, each comet result file will
     *  be processed separately by Percolator and, if requested, uploaded to Limelight as a
     *  separate search. If false, all comet results are combined together for a single Percolator
     *  run, and the combined result will be uploaded to Limelight as a single search with
     *  sub searches.
     */
    process_separately = false
    
    result_dir = 'results/nf-ms-dda-comet' /** \type{str} Where results will be saved. */
    report_dir = 'reports/nf-ms-dda-comet' /** \type{str} Where results will be saved. */
    email = null           /** \type{str} An email to alert on completion. */

    // Limelight params
    limelight_tags = null
    limelight_upload = false
    limelight_import_decoys = false
    limelight_entrapment_prefix = null

    // AWS region used by the AWS Secrets Manager bridge (see lib/AwsSecrets.groovy);
    // only consulted when running on AWS Batch. Set by the `aws` profile.
    aws_region = null
}

plugins {
    id 'nf-amazon'
    id 'nf-schema@2.7.2'
}

// Validate params against nextflow_schema.json (see main.nf: validateParameters).
// 2.7.2 supports both Nextflow 25.10 and 26.04 (requires >=25.10). A param absent
// from the schema only warns ("warn"), so stray/carried-forward params (e.g. an
// old --max_cpus from a copied config) no longer abort the run; the tradeoff is
// that a typo'd flag is silently ignored rather than caught. Type validation of
// KNOWN params stays strict (validateParameters() core, separate from this flag).
// Every user-settable param — including the `images` container map
// (container_images.config) — is still described in the schema.
validation {
    logging.unrecognisedParams = 'warn'
}

docker {
    enabled = true
}

// Secrets (PANORAMA_API_KEY, LIMELIGHT_SUBMIT_UPLOAD_KEY) are NOT loaded here.
// Each consuming process declares Nextflow's native `secret` directive; on AWS
// Batch (where that directive isn't honored) they are bridged via AWS Secrets
// Manager. See lib/AwsSecrets.groovy, modules/aws.nf, and CLAUDE.md §4.9.

// Execution Profiles
profiles {

    /*
     * Params for running pipeline on the local computer (e.g.:
     * your laptop). These can be overridden in the local config file.
     */
    standard {
        process.executor = 'local'

        // limit nextflow to running 1 task at a time
        executor.queueSize = 1

        // Cap per-process resources at this machine's capacity (see
        // conf/base.config for why this is a literal map, not params).
        process.resourceLimits = [ cpus: 8, memory: '12.GB', time: '240.h' ]

        // where to cache mzml files after running msconvert
        params.mzml_cache_directory = '/data/mass_spec/nextflow/nf-ms-dda-comet/mzml_cache'
        params.panorama_cache_directory = '/data/mass_spec/nextflow/panorama/raw_cache'
    }

    slurm {
        process.executor = 'slurm'

        process.resourceLimits = [ cpus: 8, memory: '12.GB', time: '240.h' ]

        // where to cache mzml files after running msconvert
        params.mzml_cache_directory = '/data/mass_spec/nextflow/nf-ms-dda-comet/mzml_cache'
        params.panorama_cache_directory = '/data/mass_spec/nextflow/panorama/raw_cache'
    }

    /*
     * Params for running on AWS Batch. The activation of this profile is also
     * what tells the workflow to bridge secrets through AWS Secrets Manager
     * (see modules/aws.nf) — `workflow.profile` must contain 'aws'. Queue,
     * S3 cache directories, and credentials are supplied by the user's config
     * (see docs: set_up_aws). aws_region must be set for the secrets bridge.
     */
    aws {
        process.executor = 'awsbatch'

        // The AWS Secrets Manager bridge MUST run on the launch host (the
        // native `secret` directive doesn't work on Batch). This selector
        // pins it to local regardless of the blanket executor above.
        process {
            withName: 'GET_AWS_USER_ID|BUILD_AWS_PANORAMA_SECRET|BUILD_AWS_LIMELIGHT_SECRET' {
                executor = 'local'
            }
        }

        params.aws_region = 'us-west-2'
        process.resourceLimits = [ cpus: 32, memory: '120.GB', time: '240.h' ]
    }

}

// Manifest
manifest {
    name            = 'nf-ms-dda-comet'
    author          = 'Michael Riffle'
    homePage        = 'https://github.com/mriffle/nf-ms-dda-comet'
    description     = 'Automated Nextflow workflow for processing data with comet, percolator and uploading to Limelight.'
    mainScript      = 'main.nf'
    // Floor is set by the nf-schema plugin: 2.7.2 is the only line that works
    // correctly on Nextflow 26, and it requires >=25.10. Older nf-schema (2.5.x,
    // floor 25.04) misbehaves on NF 26 (its `validation` config options are
    // ignored, breaking type-casting), so 25.10 is the real minimum.
    nextflowVersion = '!>=25.10.0'
}

// Capture exit codes from upstream processes when piping
process.shell = ['/bin/bash', '-euo', 'pipefail']

// A launch timestamp tags the report filenames so reruns don't clobber each
// other. The strict (v2) config parser forbids top-level `def`, so it is
// computed inline per file (the values may differ by at most a second).
timeline {
    enabled = true
    file    = "${params.report_dir}/execution_timeline_${new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')}.html"
}
report {
    enabled = true
    file    = "${params.report_dir}/execution_report_${new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')}.html"
}
trace {
    enabled = true
    file    = "${params.report_dir}/execution_trace_${new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')}.txt"
}
dag {
    enabled = false
    file    = "${params.report_dir}/pipeline_dag_${new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')}.html"
}

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

// Load the images to use for all processes
includeConfig 'container_images.config'
